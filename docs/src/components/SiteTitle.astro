---
import { getEntry } from 'astro:content'
import Default from '@astrojs/starlight/components/SiteTitle.astro'
import { Badge } from '@astrojs/starlight/components'
const plugin = await getEntry('gradlePlugins', 'de.infolektuell.jpackage')
const { href, version } = plugin.data
---

<Default>
    <slot />
</Default>
<a class="site-title sl-flex" {href} target="_blank">
    <Badge text={version} variant="success" size="large" />
</a>
